{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "auto-portal",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
}
