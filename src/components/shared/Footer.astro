---
const footerRefs = [
  { href: "/historia", label: "Historia" },
  { href: "/mision", label: "Misión" },
  { href: "/vision", label: "Visión" },
];

const year = new Date().getFullYear();
---

<footer class="w-full border-t border-aztec-950/15 mt-auto">
  <div class="container flex flex-col items-center gap-7 py-10">
    <section id="nosotros-resumen" class="text-center max-w-2xl">
      <h2 class="text-base tracking-tight text-aztec-950 mb-2">
        Sobre nosotros
      </h2>
      <p class="text-sm text-aztec-950/65 mb-4">
        Conoce nuestra trayectoria, propósito y proyección como proveedores del
        sector automotriz.
      </p>
      <nav class="cluster">
        {
          footerRefs.map((link) => (
            <a class="pill" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </section>

    <div class="text-center">
      <p class="text-xs text-aztec-950/60 mb-0">
        © {year} Proveedora Automotriz Laja-Bajío. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
