---
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Misión">
  <Navbar />
  <main>
    <article>
      <h1>Misión</h1>
      <blockquote>
        <p>
          Suministrar componentes, insumos y servicios industriales con calidad,
          trazabilidad y tiempos de respuesta confiables, apoyando la operación
          de nuestros clientes del sector automotriz en la región Laja-Bajío.
        </p>
      </blockquote>

      <section>
        <h2>Valores</h2>
        <ul>
          <li>Compromiso con los tiempos de entrega.</li>
          <li>Calidad verificable en cada proceso.</li>
          <li>Honestidad en la comunicación comercial.</li>
          <li>Mejora continua de capacidades técnicas.</li>
          <li>Respeto por las normas de seguridad industrial.</li>
        </ul>
      </section>
    </article>
  </main>
</Layout>
